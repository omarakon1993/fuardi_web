# Clave de acceso de Web3Forms (https://web3forms.com). Crea la tuya con el
# correo de la fundación y guárdala en .env.local (no se sube a git).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Agenda desde Google Calendar (opcional). Paso a paso en
# docs/agenda-google-calendar.md. Sin estas dos, la agenda usa src/data/eventos.ts.
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
